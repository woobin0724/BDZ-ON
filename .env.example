# ─────────────────────────────────────────────
# 온잇다 환경설정 예시 — 이 파일을 복사해서 .env 로 저장하세요.
# 키가 비어 있으면 mock 데이터로 동작합니다 (인터넷 불필요).
# ─────────────────────────────────────────────

# 기상청 API (공공데이터포털 일반 인증키, Decoding 키)
#  - 단기예보: 기상청_단기예보 조회서비스 (VilageFcstInfoService_2.0)
#  - 기상특보: 기상청_기상특보 조회서비스 (WthrWrnInfoService)
KMA_API_KEY=

# KAMIS 농산물 가격정보 API (www.kamis.or.kr → Open API 신청)
KAMIS_CERT_KEY=
KAMIS_CERT_ID=

# 시작할 때 시연 모드(알림 단계 10초 간격)로 켤지 여부
DEMO_MODE=true

# 백엔드 포트 (프론트 개발 서버 프록시도 이 값을 사용)
BACKEND_PORT=8000
